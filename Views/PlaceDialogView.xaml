<Window x:Class="Bibliothek.Views.PlaceDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ort"
        Width="440"
        Height="270"
        ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Ort bearbeiten" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,18" />
            <TextBlock Text="Name" />
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" />
            <TextBlock Text="Postleitzahl" />
            <TextBox Text="{Binding PostalCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Abbrechen" Style="{StaticResource SecondaryButton}" Click="Cancel_Click" />
            <Button Content="Speichern" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
