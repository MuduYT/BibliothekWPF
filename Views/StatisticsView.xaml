<UserControl x:Class="Bibliothek.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Statistiken" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Summary}" Margin="0,10,0,20" Foreground="{StaticResource BrushMuted}" />
        <ItemsControl ItemsSource="{Binding Highlights}"
                      Background="#2D2D2D"
                      Foreground="#F0F0F0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource BrushPanelAlt}" Padding="16" Margin="0,0,0,10">
                        <TextBlock Text="{Binding}" FontSize="16" />
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
