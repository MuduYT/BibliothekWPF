<UserControl x:Class="Bibliothek.Views.AuthorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Neu" Command="{Binding AddCommand}" />
                <Button Content="Bearbeiten" Command="{Binding EditCommand}" Style="{StaticResource SecondaryButton}" />
                <Button Content="Loeschen" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Autoren" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="Autoren verwalten und durchsuchen" Foreground="{StaticResource BrushMuted}" />
            </StackPanel>
        </DockPanel>
        <TextBox Grid.Row="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />
        <DataGrid Grid.Row="2" ItemsSource="{Binding ItemsView}" SelectedItem="{Binding SelectedItem}"
                  Background="#2D2D2D"
                  Foreground="#FFFFFF"
                  RowBackground="#2D2D2D"
                  AlternatingRowBackground="#333333"
                  BorderBrush="#444444"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#444444"
                  VerticalGridLinesBrush="#444444"
                  ColumnHeaderStyle="{StaticResource DarkDataGridColumnHeaderStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Jahrgang" Binding="{Binding Jahrgang}" Width="140" />
                <DataGridTextColumn Header="Buecher" Binding="{Binding Buecher.Count}" Width="120" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
