<UserControl x:Class="Bibliothek.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="520" HorizontalAlignment="Left">
        <TextBlock Text="Einstellungen" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Text="Basis fuer Datenbank und Theme" Foreground="{StaticResource BrushMuted}" Margin="0,4,0,24" />

        <TextBlock Text="Datenbankserver" FontWeight="SemiBold" />
        <TextBox Text="{Binding DatabaseServer}" Margin="0,6,0,18" />

        <CheckBox Content="Dunkelmodus vorbereitet"
                  IsChecked="{Binding IsDarkModePrepared}"
                  Margin="0,8,0,0" />
    </StackPanel>
</UserControl>
