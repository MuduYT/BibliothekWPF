<Window x:Class="Bibliothek.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:Bibliothek.ViewModels"
        Title="Bibliothek Verwaltung"
        Width="1280"
        Height="820"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{StaticResource BrushSurface}">
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="8"
                      CornerRadius="8"
                      GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Left navigation rail icon button with hover scale + active state -->
        <Style x:Key="NavRailButton" TargetType="Button">
            <Setter Property="Width" Value="64" />
            <Setter Property="Height" Value="56" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="Indicator"
                                    Width="3" Height="24"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    CornerRadius="0,2,2,0"
                                    Background="{StaticResource BrushPrimary}"
                                    Opacity="0" />
                            <Border x:Name="Pill"
                                    Width="44" Height="44"
                                    CornerRadius="12"
                                    Background="Transparent"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="PillScale" ScaleX="1" ScaleY="1" />
                                </Border.RenderTransform>
                                <Path x:Name="Icon"
                                      Width="24" Height="24"
                                      Stretch="Uniform"
                                      Fill="#8A9EAD"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Icon}" Value="Places">
                                <Setter TargetName="Icon" Property="Data" Value="{StaticResource IconLocation}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Icon}" Value="Publishers">
                                <Setter TargetName="Icon" Property="Data" Value="{StaticResource IconPublisher}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Icon}" Value="Authors">
                                <Setter TargetName="Icon" Property="Data" Value="{StaticResource IconAuthor}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Icon}" Value="Books">
                                <Setter TargetName="Icon" Property="Data" Value="{StaticResource IconBook}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Icon}" Value="Settings">
                                <Setter TargetName="Icon" Property="Data" Value="{StaticResource IconSettings}" />
                            </DataTrigger>

                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{StaticResource BrushAccent}" />
                                <Setter TargetName="Icon" Property="Fill" Value="White" />
                                <Setter TargetName="Indicator" Property="Opacity" Value="1" />
                            </DataTrigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Icon" Property="Fill" Value="White" />
                                <Setter TargetName="Pill" Property="Background" Value="#0E1620" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PillScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.15" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="PillScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.15" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PillScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="PillScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left Strip (Settings only) -->
            <ColumnDefinition Width="64" />
            <!-- Main Content Area -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left navigation rail: 4 table icons (+ settings pinned at bottom) -->
        <Border Grid.Column="0" Background="#070B0F" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Bottom"
                        Style="{StaticResource NavRailButton}"
                        Margin="0,0,0,12"
                        DataContext="{Binding SettingsNavigationItem}"
                        ToolTip="{Binding Title}"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}" />

                <ItemsControl ItemsSource="{Binding TableNavigationItems}"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource NavRailButton}"
                                    Margin="0,4"
                                    ToolTip="{Binding Title}"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Main Column Content Grid -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- Window Controls bar height -->
                <RowDefinition Height="32" />
                <!-- Content Area -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Back Button (Top Left) -->
            <Button Grid.Row="0"
                    Command="{Binding GoHomeCommand}"
                    Visibility="{Binding ShowBackButton, Converter={StaticResource BoolToVisibilityConverter}}"
                    Width="46" Height="32"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    WindowChrome.IsHitTestVisibleInChrome="True"
                    ToolTip="Zurück zur Startseite"
                    Margin="8,0,0,0"
                    Panel.ZIndex="100">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <!-- Left Arrow Icon -->
                            <Path Data="M 12 4 L 4 12 L 12 20 M 4 12 L 20 12"
                                  Stroke="#8A9EAD"
                                  StrokeThickness="1.5"
                                  Width="16" Height="16"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#16222F"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Custom Window Controls Panel (Top Right) -->
            <StackPanel Grid.Row="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Orientation="Horizontal"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Panel.ZIndex="100">
                <Button x:Name="BtnMinimize"
                        Width="46" Height="32"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="MinimizeButton_Click"
                        ToolTip="Minimieren">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}">
                                <Path Data="M0,6 H10"
                                      Stroke="#8A9EAD"
                                      StrokeThickness="1"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#16222F"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="BtnMaximize"
                        Width="46" Height="32"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="MaximizeButton_Click"
                        ToolTip="Maximieren">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}">
                                <Path Data="M1,1 H9 V9 H1 Z"
                                      Stroke="#8A9EAD"
                                      StrokeThickness="1"
                                      Fill="Transparent"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#16222F"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="BtnClose"
                        Width="46" Height="32"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="CloseButton_Click"
                        ToolTip="Schließen">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}">
                                <Path Data="M1,1 L9,9 M9,1 L1,9"
                                      Stroke="#8A9EAD"
                                      StrokeThickness="1.2"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#C42B1C"/>
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <!-- Dynamic Workspace Content View -->
            <ContentControl Grid.Row="1"
                            x:Name="MainContent"
                            Content="{Binding CurrentViewModel}"
                            Margin="32,16,32,32">
    <ContentControl.RenderTransform>
        <TranslateTransform X="0" />
    </ContentControl.RenderTransform>
<ContentControl.Style>
    <Style TargetType="ContentControl">
        <Style.Triggers>
            <!-- Slide‑in when Settings is shown -->
            <DataTrigger Binding="{Binding CurrentViewModel}" Value="{x:Type viewModels:SettingsViewModel}">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(TranslateTransform.X)"
                                             To="0" Duration="0:0:0.3" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <!-- Slide‑out when leaving Settings -->
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(TranslateTransform.X)"
                                             To="-300" Duration="0:0:0.2" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ContentControl.Style>
</ContentControl>
        </Grid>
    </Grid>
</Window>
