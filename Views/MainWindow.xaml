<Window x:Class="Bibliothek.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:Bibliothek.ViewModels"
        Title="Bibliothek Verwaltung"
        Width="1280"
        Height="820"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{StaticResource BrushSurface}">
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="8"
                      CornerRadius="8"
                      GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left Strip (Settings only) -->
            <ColumnDefinition Width="64" />
            <!-- Main Content Area -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Strip containing ONLY Settings Gear in the middle -->
        <Border Grid.Column="0" Background="#070B0F">
            <Grid>
                <Button Command="{Binding NavigateCommand}"
                        CommandParameter="{Binding SettingsNavigationItem}"
                        Width="64" Height="64"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        ToolTip="Einstellungen">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="PillBorder"
                                    Background="Transparent"
                                    CornerRadius="32">
                                <Path x:Name="IconPath"
                                      Width="28" Height="28"
                                      Stretch="Uniform"
                                      Fill="#8A9EAD"
                                      Data="{StaticResource IconSettings}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!-- Selection States -->
                                <DataTrigger Binding="{Binding SettingsNavigationItem.IsSelected}" Value="True">
                                    <Setter TargetName="PillBorder" Property="Background" Value="#16222F" />
                                    <Setter TargetName="IconPath" Property="Fill" Value="White" />
                                </DataTrigger>

                                <!-- Hover States -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=IsMouseOver}" Value="True" />
                                        <Condition Binding="{Binding SettingsNavigationItem.IsSelected}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="PillBorder" Property="Background" Value="#0E1620" />
                                    <Setter TargetName="IconPath" Property="Fill" Value="White" />
                                </MultiDataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- Main Column Content Grid -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- Window Controls bar height -->
                <RowDefinition Height="32" />
                <!-- Content Area -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Back Button (Top Left) -->
            <Button Grid.Row="0"
                    Command="{Binding GoHomeCommand}"
                    Visibility="{Binding ShowBackButton, Converter={StaticResource BoolToVisibilityConverter}}"
                    Width="46" Height="32"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    WindowChrome.IsHitTestVisibleInChrome="True"
                    ToolTip="Zurück zur Startseite"
                    Margin="8,0,0,0"
                    Panel.ZIndex="100">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <!-- Left Arrow Icon -->
                            <Path Data="M 12 4 L 4 12 L 12 20 M 4 12 L 20 12"
                                  Stroke="#8A9EAD"
                                  StrokeThickness="1.5"
                                  Width="16" Height="16"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#16222F"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Custom Window Controls Panel (Top Right) -->
            <StackPanel Grid.Row="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Orientation="Horizontal"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Panel.ZIndex="100">
                <Button x:Name="BtnMinimize"
                        Width="46" Height="32"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="MinimizeButton_Click"
                        ToolTip="Minimieren">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}">
                                <Path Data="M0,6 H10"
                                      Stroke="#8A9EAD"
                                      StrokeThickness="1"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#16222F"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="BtnMaximize"
                        Width="46" Height="32"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="MaximizeButton_Click"
                        ToolTip="Maximieren">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}">
                                <Path Data="M1,1 H9 V9 H1 Z"
                                      Stroke="#8A9EAD"
                                      StrokeThickness="1"
                                      Fill="Transparent"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#16222F"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="BtnClose"
                        Width="46" Height="32"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="CloseButton_Click"
                        ToolTip="Schließen">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}">
                                <Path Data="M1,1 L9,9 M9,1 L1,9"
                                      Stroke="#8A9EAD"
                                      StrokeThickness="1.2"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#C42B1C"/>
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <!-- Dynamic Workspace Content View -->
            <ContentControl Grid.Row="1"
                            x:Name="MainContent"
                            Content="{Binding CurrentViewModel}"
                            Margin="32,16,32,32">
    <ContentControl.RenderTransform>
        <TranslateTransform X="0" />
    </ContentControl.RenderTransform>
<ContentControl.Style>
    <Style TargetType="ContentControl">
        <Style.Triggers>
            <!-- Slide‑in when Settings is shown -->
            <DataTrigger Binding="{Binding CurrentViewModel}" Value="{x:Type viewModels:SettingsViewModel}">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(TranslateTransform.X)"
                                             To="0" Duration="0:0:0.3" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <!-- Slide‑out when leaving Settings -->
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(TranslateTransform.X)"
                                             To="-300" Duration="0:0:0.2" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ContentControl.Style>
</ContentControl>
        </Grid>
    </Grid>
</Window>
