<Window x:Class="Bibliothek.Views.BookDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Buch"
        Width="520"
        Height="480"
        ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Buch bearbeiten" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,18" />
            <TextBlock Text="Titel" />
            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" />
            <TextBlock Text="ISBN" />
            <TextBox Text="{Binding Isbn, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding IsIsbnEditable}"
                     Margin="0,6,0,12" />
            <TextBlock Text="Seiten" />
            <TextBox Text="{Binding PageCount, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" />
            <TextBlock Text="Erscheinungsjahr" />
            <TextBox Text="{Binding PublicationYear, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" />
            <TextBlock Text="Autor" />
            <ComboBox ItemsSource="{Binding Authors}" SelectedItem="{Binding SelectedAuthor}" DisplayMemberPath="Name" Margin="0,6,0,12" />
            <TextBlock Text="Verlag" />
            <ComboBox ItemsSource="{Binding Publishers}" SelectedItem="{Binding SelectedPublisher}" DisplayMemberPath="Name" Margin="0,6,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Abbrechen" Style="{StaticResource SecondaryButton}" Click="Cancel_Click" />
            <Button Content="Speichern" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
