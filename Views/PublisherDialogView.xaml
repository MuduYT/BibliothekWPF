<Window x:Class="Bibliothek.Views.PublisherDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Verlag"
        Width="500"
        Height="390"
        ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Verlag bearbeiten" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,18" />
            <TextBlock Text="Name" />
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" />
            <TextBlock Text="Telefon" />
            <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" />
            <TextBlock Text="E-Mail" />
            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" />
            <TextBlock Text="Firmensitz" />
            <ComboBox ItemsSource="{Binding Places}" SelectedItem="{Binding SelectedPlace}" DisplayMemberPath="Name" Margin="0,6,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Abbrechen" Style="{StaticResource SecondaryButton}" Click="Cancel_Click" />
            <Button Content="Speichern" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
