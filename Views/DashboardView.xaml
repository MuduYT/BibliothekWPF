<UserControl x:Class="Bibliothek.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Smooth, fully clickable dashboard card -->
        <Style x:Key="DashboardCardButton" TargetType="Button">
            <Setter Property="Background" Value="#111A24" />
            <Setter Property="BorderBrush" Value="#1A2835" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                ClipToBounds="True"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#33546F" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.03" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.03" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Background Sparkle Decorator (bottom-right) -->
        <Path Data="M 12 2 C 12 7.5 16.5 12 22 12 C 16.5 12 12 16.5 12 22 C 12 16.5 7.5 12 2 12 C 7.5 12 12 7.5 12 2 Z"
              Fill="#8A9EAD"
              Opacity="0.15"
              Width="48" Height="48"
              Stretch="Uniform"
              HorizontalAlignment="Right"
              VerticalAlignment="Bottom"
              Margin="0,0,-8,-8"
              Panel.ZIndex="0"/>

        <Grid Panel.ZIndex="1">
            <Grid.RowDefinitions>
                <!-- Title Header Row -->
                <RowDefinition Height="Auto" />
                <!-- Cards Row -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header Section -->
            <StackPanel Grid.Row="0" Margin="0,8,0,32">
                <TextBlock Text="Willkommen"
                           FontFamily="Georgia, serif"
                           FontSize="38"
                           FontWeight="Normal"
                           Foreground="White" />
                <TextBlock Text="Wählen Sie einen Bereich, um fortzufahren."
                           Foreground="#8A9EAD"
                           FontSize="15"
                           Margin="0,6,0,0" />
            </StackPanel>

            <!-- 4 Visual Cards Row -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- CARD 1: ORTE -->
                <Button Grid.Column="0"
                        Style="{StaticResource DashboardCardButton}"
                        Margin="0,0,12,0"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding DataContext.MainNavigationItems[1], RelativeSource={RelativeSource AncestorType=Window}}">
                    <Grid>
                        <!-- Top highlighted indicator line -->
                        <Border Height="3" Background="#4B7EB0" VerticalAlignment="Top" CornerRadius="8,8,0,0"/>

                        <!-- Placeholder Image -->
                        <Image Source="/Resources/Images/card_orte.png"
                               Stretch="UniformToFill"
                               Height="200"
                               VerticalAlignment="Top"/>

                        <!-- Gradient fade overlay from image to card background -->
                        <Border Height="200" VerticalAlignment="Top">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="Transparent" Offset="0.4"/>
                                    <GradientStop Color="#111A24" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- Circular Overlay Icon Badge -->
                        <Border Width="64" Height="64"
                                CornerRadius="32"
                                Background="#E5111A24"
                                BorderBrush="#4B7EB0"
                                BorderThickness="1.5"
                                VerticalAlignment="Top"
                                Margin="24,168,0,0"
                                HorizontalAlignment="Left">
                            <Path Data="{StaticResource IconLocation}"
                                  Fill="#90B2D4"
                                  Width="24" Height="24"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>

                        <!-- Name -->
                        <TextBlock Text="Orte"
                                   FontFamily="Georgia, serif"
                                   FontSize="28"
                                   Foreground="White"
                                   VerticalAlignment="Top"
                                   Margin="24,244,24,0"/>
                    </Grid>
                </Button>

                <!-- CARD 2: VERLAGE -->
                <Button Grid.Column="1"
                        Style="{StaticResource DashboardCardButton}"
                        Margin="12,0,12,0"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding DataContext.MainNavigationItems[2], RelativeSource={RelativeSource AncestorType=Window}}">
                    <Grid>
                        <!-- Top highlighted indicator line -->
                        <Border Height="3" Background="#3271A5" VerticalAlignment="Top" CornerRadius="8,8,0,0"/>

                        <!-- Placeholder Image -->
                        <Image Source="/Resources/Images/card_verlage.png"
                               Stretch="UniformToFill"
                               Height="200"
                               VerticalAlignment="Top"/>

                        <!-- Gradient fade overlay -->
                        <Border Height="200" VerticalAlignment="Top">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="Transparent" Offset="0.4"/>
                                    <GradientStop Color="#111A24" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- Circular Overlay Icon Badge -->
                        <Border Width="64" Height="64"
                                CornerRadius="32"
                                Background="#E5111A24"
                                BorderBrush="#3271A5"
                                BorderThickness="1.5"
                                VerticalAlignment="Top"
                                Margin="24,168,0,0"
                                HorizontalAlignment="Left">
                            <Path Data="{StaticResource IconPublisher}"
                                  Fill="#78A5C8"
                                  Width="24" Height="24"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>

                        <!-- Name -->
                        <TextBlock Text="Verlage"
                                   FontFamily="Georgia, serif"
                                   FontSize="28"
                                   Foreground="White"
                                   VerticalAlignment="Top"
                                   Margin="24,244,24,0"/>
                    </Grid>
                </Button>

                <!-- CARD 3: AUTHORS -->
                <Button Grid.Column="2"
                        Style="{StaticResource DashboardCardButton}"
                        Margin="12,0,12,0"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding DataContext.MainNavigationItems[3], RelativeSource={RelativeSource AncestorType=Window}}">
                    <Grid>
                        <!-- Top highlighted indicator line -->
                        <Border Height="3" Background="#7A4C9F" VerticalAlignment="Top" CornerRadius="8,8,0,0"/>

                        <!-- Placeholder Image -->
                        <Image Source="/Resources/Images/card_authors.png"
                               Stretch="UniformToFill"
                               Height="200"
                               VerticalAlignment="Top"/>

                        <!-- Gradient fade overlay -->
                        <Border Height="200" VerticalAlignment="Top">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="Transparent" Offset="0.4"/>
                                    <GradientStop Color="#111A24" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- Circular Overlay Icon Badge -->
                        <Border Width="64" Height="64"
                                CornerRadius="32"
                                Background="#E5111A24"
                                BorderBrush="#7A4C9F"
                                BorderThickness="1.5"
                                VerticalAlignment="Top"
                                Margin="24,168,0,0"
                                HorizontalAlignment="Left">
                            <Path Data="{StaticResource IconAuthor}"
                                  Fill="#A687BF"
                                  Width="24" Height="24"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>

                        <!-- Name -->
                        <TextBlock Text="Authors"
                                   FontFamily="Georgia, serif"
                                   FontSize="28"
                                   Foreground="White"
                                   VerticalAlignment="Top"
                                   Margin="24,244,24,0"/>
                    </Grid>
                </Button>

                <!-- CARD 4: BOOKS -->
                <Button Grid.Column="3"
                        Style="{StaticResource DashboardCardButton}"
                        Margin="12,0,0,0"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding DataContext.MainNavigationItems[4], RelativeSource={RelativeSource AncestorType=Window}}">
                    <Grid>
                        <!-- Top highlighted indicator line -->
                        <Border Height="3" Background="#9C7B4C" VerticalAlignment="Top" CornerRadius="8,8,0,0"/>

                        <!-- Placeholder Image -->
                        <Image Source="/Resources/Images/card_books.png"
                               Stretch="UniformToFill"
                               Height="200"
                               VerticalAlignment="Top"/>

                        <!-- Gradient fade overlay -->
                        <Border Height="200" VerticalAlignment="Top">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="Transparent" Offset="0.4"/>
                                    <GradientStop Color="#111A24" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- Circular Overlay Icon Badge -->
                        <Border Width="64" Height="64"
                                CornerRadius="32"
                                Background="#E5111A24"
                                BorderBrush="#9C7B4C"
                                BorderThickness="1.5"
                                VerticalAlignment="Top"
                                Margin="24,168,0,0"
                                HorizontalAlignment="Left">
                            <Path Data="{StaticResource IconBook}"
                                  Fill="#C8A574"
                                  Width="24" Height="24"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>

                        <!-- Name -->
                        <TextBlock Text="Books"
                                   FontFamily="Georgia, serif"
                                   FontSize="28"
                                   Foreground="White"
                                   VerticalAlignment="Top"
                                   Margin="24,244,24,0"/>
                    </Grid>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
