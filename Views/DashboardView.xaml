<UserControl x:Class="Bibliothek.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <!-- Background Sparkle Decorator (bottom-right) -->
        <Path Data="M 12 2 C 12 7.5 16.5 12 22 12 C 16.5 12 12 16.5 12 22 C 12 16.5 7.5 12 2 12 C 7.5 12 12 7.5 12 2 Z"
              Fill="#8A9EAD"
              Opacity="0.15"
              Width="48" Height="48"
              Stretch="Uniform"
              HorizontalAlignment="Right"
              VerticalAlignment="Bottom"
              Margin="0,0,-8,-8"
              Panel.ZIndex="0"/>

        <Grid Panel.ZIndex="1">
            <Grid.RowDefinitions>
                <!-- Title Header Row -->
                <RowDefinition Height="Auto" />
                <!-- Cards Row -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header Section -->
            <StackPanel Grid.Row="0" Margin="0,8,0,32">
                <TextBlock Text="Willkommen"
                           FontFamily="Georgia, serif"
                           FontSize="38"
                           FontWeight="Normal"
                           Foreground="White" />
                <TextBlock Text="Wählen Sie einen Bereich, um fortzufahren."
                           Foreground="#8A9EAD"
                           FontSize="15"
                           Margin="0,6,0,0" />
            </StackPanel>

            <!-- 4 Visual Cards Row -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- CARD 1: ORTE -->
                <Border Grid.Column="0" 
                        Background="#111A24"
                        BorderBrush="#1A2835"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,12,0"
                        ClipToBounds="True">
                    <Grid>
                        <!-- Top highlighted indicator line -->
                        <Border Height="3" Background="#4B7EB0" VerticalAlignment="Top" CornerRadius="8,8,0,0"/>

                        <!-- Visual Card Header (Mountain Image) -->
                        <Image Source="/Resources/Images/card_orte.png" 
                               Stretch="UniformToFill" 
                               Height="200" 
                               VerticalAlignment="Top"/>
                        
                        <!-- Gradient fade overlay from image to card background -->
                        <Border Height="200" VerticalAlignment="Top">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="Transparent" Offset="0.4"/>
                                    <GradientStop Color="#111A24" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- Circular Overlay Icon Badge (places overlapping the boundary) -->
                        <Border Width="64" Height="64" 
                                CornerRadius="32" 
                                Background="#E5111A24"
                                BorderBrush="#4B7EB0" 
                                BorderThickness="1.5" 
                                VerticalAlignment="Top" 
                                Margin="24,168,0,0"
                                HorizontalAlignment="Left">
                            <Path Data="{StaticResource IconLocation}" 
                                  Fill="#90B2D4" 
                                  Width="24" Height="24" 
                                  Stretch="Uniform" 
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center"/>
                        </Border>

                        <!-- Card Body Content -->
                        <Grid Margin="0,232,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="Orte" 
                                       FontFamily="Georgia, serif"
                                       FontSize="28" 
                                       Foreground="White" 
                                       Margin="24,12,24,0"/>

                            <TextBlock Grid.Row="1"
                                       Text="Verwalten Sie Orte und geografische Informationen." 
                                       Foreground="#8A9EAD" 
                                       FontSize="13" 
                                       Margin="24,8,24,16" 
                                       TextWrapping="Wrap"
                                       LineHeight="18"/>

                            <!-- Öffnen Button -->
                            <Button Grid.Row="2"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding DataContext.MainNavigationItems[1], RelativeSource={RelativeSource AncestorType=Window}}"
                                    Content="Öffnen  ›"
                                    Background="#1B2A3A"
                                    Foreground="White"
                                    FontWeight="Medium"
                                    FontSize="14"
                                    Height="42"
                                    Margin="24,0,24,24"
                                    HorizontalAlignment="Stretch">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#253A50" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <!-- CARD 2: VERLAGE -->
                <Border Grid.Column="1" 
                        Background="#111A24"
                        BorderBrush="#1A2835"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="12,0,12,0"
                        ClipToBounds="True">
                    <Grid>
                        <!-- Top highlighted indicator line -->
                        <Border Height="3" Background="#3271A5" VerticalAlignment="Top" CornerRadius="8,8,0,0"/>

                        <!-- Visual Card Header (Grid Pattern Image) -->
                        <Image Source="/Resources/Images/card_verlage.png" 
                               Stretch="UniformToFill" 
                               Height="200" 
                               VerticalAlignment="Top"/>
                        
                        <!-- Gradient fade overlay -->
                        <Border Height="200" VerticalAlignment="Top">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="Transparent" Offset="0.4"/>
                                    <GradientStop Color="#111A24" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- Circular Overlay Icon Badge -->
                        <Border Width="64" Height="64" 
                                CornerRadius="32" 
                                Background="#E5111A24"
                                BorderBrush="#3271A5" 
                                BorderThickness="1.5" 
                                VerticalAlignment="Top" 
                                Margin="24,168,0,0"
                                HorizontalAlignment="Left">
                            <Path Data="{StaticResource IconPublisher}" 
                                  Fill="#78A5C8" 
                                  Width="24" Height="24" 
                                  Stretch="Uniform" 
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center"/>
                        </Border>

                        <!-- Card Body Content -->
                        <Grid Margin="0,232,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="Verlage" 
                                       FontFamily="Georgia, serif"
                                       FontSize="28" 
                                       Foreground="White" 
                                       Margin="24,12,24,0"/>

                            <TextBlock Grid.Row="1"
                                       Text="Verwalten Sie Verlage und verwandte Informationen." 
                                       Foreground="#8A9EAD" 
                                       FontSize="13" 
                                       Margin="24,8,24,16" 
                                       TextWrapping="Wrap"
                                       LineHeight="18"/>

                            <!-- Öffnen Button -->
                            <Button Grid.Row="2"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding DataContext.MainNavigationItems[2], RelativeSource={RelativeSource AncestorType=Window}}"
                                    Content="Öffnen  ›"
                                    Background="#1B2A3A"
                                    Foreground="White"
                                    FontWeight="Medium"
                                    FontSize="14"
                                    Height="42"
                                    Margin="24,0,24,24"
                                    HorizontalAlignment="Stretch">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#253A50" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <!-- CARD 3: AUTHORS -->
                <Border Grid.Column="2" 
                        Background="#111A24"
                        BorderBrush="#1A2835"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="12,0,12,0"
                        ClipToBounds="True">
                    <Grid>
                        <!-- Top highlighted indicator line -->
                        <Border Height="3" Background="#7A4C9F" VerticalAlignment="Top" CornerRadius="8,8,0,0"/>

                        <!-- Visual Card Header (Hand Writing Image) -->
                        <Image Source="/Resources/Images/card_authors.png" 
                               Stretch="UniformToFill" 
                               Height="200" 
                               VerticalAlignment="Top"/>
                        
                        <!-- Gradient fade overlay -->
                        <Border Height="200" VerticalAlignment="Top">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="Transparent" Offset="0.4"/>
                                    <GradientStop Color="#111A24" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- Circular Overlay Icon Badge -->
                        <Border Width="64" Height="64" 
                                CornerRadius="32" 
                                Background="#E5111A24"
                                BorderBrush="#7A4C9F" 
                                BorderThickness="1.5" 
                                VerticalAlignment="Top" 
                                Margin="24,168,0,0"
                                HorizontalAlignment="Left">
                            <Path Data="{StaticResource IconAuthor}" 
                                  Fill="#A687BF" 
                                  Width="24" Height="24" 
                                  Stretch="Uniform" 
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center"/>
                        </Border>

                        <!-- Card Body Content -->
                        <Grid Margin="0,232,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="Authors" 
                                       FontFamily="Georgia, serif"
                                       FontSize="28" 
                                       Foreground="White" 
                                       Margin="24,12,24,0"/>

                            <TextBlock Grid.Row="1"
                                       Text="Verwalten Sie Autoren und deren Informationen." 
                                       Foreground="#8A9EAD" 
                                       FontSize="13" 
                                       Margin="24,8,24,16" 
                                       TextWrapping="Wrap"
                                       LineHeight="18"/>

                            <!-- Öffnen Button -->
                            <Button Grid.Row="2"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding DataContext.MainNavigationItems[3], RelativeSource={RelativeSource AncestorType=Window}}"
                                    Content="Öffnen  ›"
                                    Background="#2B1D3C"
                                    Foreground="White"
                                    FontWeight="Medium"
                                    FontSize="14"
                                    Height="42"
                                    Margin="24,0,24,24"
                                    HorizontalAlignment="Stretch">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#3D2954" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <!-- CARD 4: BOOKS -->
                <Border Grid.Column="3" 
                        Background="#111A24"
                        BorderBrush="#1A2835"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="12,0,0,0"
                        ClipToBounds="True">
                    <Grid>
                        <!-- Top highlighted indicator line -->
                        <Border Height="3" Background="#9C7B4C" VerticalAlignment="Top" CornerRadius="8,8,0,0"/>

                        <!-- Visual Card Header (Bookshelf Image) -->
                        <Image Source="/Resources/Images/card_books.png" 
                               Stretch="UniformToFill" 
                               Height="200" 
                               VerticalAlignment="Top"/>
                        
                        <!-- Gradient fade overlay -->
                        <Border Height="200" VerticalAlignment="Top">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="Transparent" Offset="0.4"/>
                                    <GradientStop Color="#111A24" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- Circular Overlay Icon Badge -->
                        <Border Width="64" Height="64" 
                                CornerRadius="32" 
                                Background="#E5111A24"
                                BorderBrush="#9C7B4C" 
                                BorderThickness="1.5" 
                                VerticalAlignment="Top" 
                                Margin="24,168,0,0"
                                HorizontalAlignment="Left">
                            <Path Data="{StaticResource IconBook}" 
                                  Fill="#C8A574" 
                                  Width="24" Height="24" 
                                  Stretch="Uniform" 
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center"/>
                        </Border>

                        <!-- Card Body Content -->
                        <Grid Margin="0,232,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="Books" 
                                       FontFamily="Georgia, serif"
                                       FontSize="28" 
                                       Foreground="White" 
                                       Margin="24,12,24,0"/>

                            <TextBlock Grid.Row="1"
                                       Text="Verwalten Sie Bücher und Bibliotheksdaten." 
                                       Foreground="#8A9EAD" 
                                       FontSize="13" 
                                       Margin="24,8,24,16" 
                                       TextWrapping="Wrap"
                                       LineHeight="18"/>

                            <!-- Öffnen Button -->
                            <Button Grid.Row="2"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding DataContext.MainNavigationItems[4], RelativeSource={RelativeSource AncestorType=Window}}"
                                    Content="Öffnen  ›"
                                    Background="#3C2B1D"
                                    Foreground="White"
                                    FontWeight="Medium"
                                    FontSize="14"
                                    Height="42"
                                    Margin="24,0,24,24"
                                    HorizontalAlignment="Stretch">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#553D2A" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
